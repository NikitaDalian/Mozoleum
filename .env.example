# ── МОЗОЛЕУМ server configuration ──────────────────────────────────────────
# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# Port the API server listens on.
PORT=8787

# Comma-separated list of allowed CORS origins for the browser app and your bot.
# Use "*" to allow any origin (fine for a public image API). For the website,
# list its deployed URL, e.g. https://mozoleum.example.com
CORS_ORIGIN=*

# ── LLM motto enrichment (optional) ────────────────────────────────────────
# If set, the server will call the Anthropic API to generate fresh heraldic
# mottos. The key stays on the SERVER and is never sent to the browser.
# Leave empty to use the built-in curated motto bank (fully offline).
ANTHROPIC_API_KEY=
# Model id for motto generation (latest small/fast Claude is a good default).
MOTTO_MODEL=claude-haiku-4-5-20251001

# ── Frontend build-time config (apps/web) ──────────────────────────────────
# Base URL the website uses to reach the API. In local dev the Vite proxy
# handles /api, so this can stay empty. In production set it to your API origin
# if the API is hosted separately from the static site.
VITE_API_BASE=
